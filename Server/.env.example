# Copy this file to .env, then paste your own key. Never commit .env.
GROQ_API_KEY=
# The model must be available on your Groq account's Limits page.
GROQ_MODEL=openai/gpt-oss-20b
# Stay under the service's daily free limit (~200,000 tokens is about 250 replies).
MAX_REQUESTS_PER_DAY=250
# AI replies one player can get per day before Marlow uses his written lines.
MAX_REPLIES_PER_PLAYER_PER_DAY=40
# Must match the key built into the game (MarlowClient). Leave empty to accept any client.
GAME_KEY=
# Leave as low for openai/gpt-oss models; set empty for models without reasoning.
GROQ_REASONING_EFFORT=low
